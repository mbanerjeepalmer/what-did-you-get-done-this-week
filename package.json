{
  "name": "what-did-you-get-done-this-week",
  "version": "0.0.1",
  "description": "Checks what you got done at an interval.",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "postbuild": "node scripts/fix-shebang.js && node scripts/build-mac-helper.js",
    "test": "npm run build && node --test 'dist/**/*.test.js'",
    "test:vm": "scripts/vm.sh test",
    "test:e2e": "scripts/vm-e2e.sh",
    "deploy": "npm run build && node scripts/schedule.js install",
    "start": "npm run deploy",
    "stop": "node scripts/stop.js",
    "restart": "npm run stop && npm run start",
    "snooze": "node dist/snooze.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbanerjeepalmer/what-did-you-get-done-this-week.git"
  },
  "keywords": [
    "productivity",
    "argos",
    "calendar"
  ],
  "author": "Maurice Banerjee Palmer",
  "license": " AGPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/mbanerjeepalmer/what-did-you-get-done-this-week/issues"
  },
  "homepage": "https://github.com/mbanerjeepalmer/what-did-you-get-done-this-week#readme",
  "devDependencies": {
    "@types/node": "^24.3.1",
    "typescript": "^5.9.2"
  }
}
